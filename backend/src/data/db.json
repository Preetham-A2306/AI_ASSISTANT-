  "chunks": [
    {
      "id": "c31a1712-b1a1-4a12-9117-d0ade5f54b59",
      "documentId": "952ed0e1-20a2-46b0-87e9-63d23869fb8d",
      "documentTitle": "Engineering_Code_Review_Process.md",
      "section": "Branch Naming",
      "text": "# Branch Naming\nEngineering branches use the format `type/short-description`, for example `feature/profile-search` or `fix/login-timeout`.\n# Pull Request Submission"
    },
    {
      "id": "609f3a7d-b83e-4b67-ab63-da620d3372ea",
      "documentId": "952ed0e1-20a2-46b0-87e9-63d23869fb8d",
      "documentTitle": "Engineering_Code_Review_Process.md",
      "section": "Pull Request Submission",
      "text": "Push your branch to the company Git repository and open a pull request against the `main` branch. Include a clear summary, testing notes, and screenshots when the change affects the UI.\n# Reviewer Requirements\nEvery production-bound pull request requires at least one reviewer from the owning engineering team. Changes affecting security or data access require an additional reviewer familiar with the affected area."
    },
    {
      "id": "68062fb6-2646-4f86-a021-d9ca3f388f2f",
      "documentId": "952ed0e1-20a2-46b0-87e9-63d23869fb8d",
      "documentTitle": "Engineering_Code_Review_Process.md",
      "section": "Approval and Merge",
      "text": "# Approval and Merge\nAddress reviewer comments before merging. A pull request may be merged after required approvals and successful CI checks. The author should use squash merge unless the team manager documents another strategy."
    },
    {
      "id": "a16a81d9-40b1-472b-a072-207c8070549a",
      "documentId": "928c67a4-0562-4f93-8a5f-03f5dc51609d",
      "documentTitle": "Expense_Reimbursement_Policy.md",
      "section": "Eligible Expenses",
      "text": "# Eligible Expenses\nReasonable business travel, approved client meals, and pre-approved work expenses may be reimbursed when supported by receipts.\n# Reimbursement Process"
    },
    {
      "id": "ee0cefc5-7003-4e46-b097-ce066dc278a7",
      "documentId": "928c67a4-0562-4f93-8a5f-03f5dc51609d",
      "documentTitle": "Expense_Reimbursement_Policy.md",
      "section": "Reimbursement Process",
      "text": "Submit the expense through the company expense portal. Select the appropriate category, attach the receipt, and add a short business purpose.\n# Submission Deadline\nExpenses should be submitted within 15 calendar days after the expense date."
    },
    {
      "id": "8c59a5c2-204e-427d-b4d6-299b9b514289",
      "documentId": "928c67a4-0562-4f93-8a5f-03f5dc51609d",
      "documentTitle": "Expense_Reimbursement_Policy.md",
      "section": "Required Receipts",
      "text": "# Required Receipts\nReceipts are required for reimbursable expenses. If a receipt is unavailable, contact Finance before submitting the claim."
    },
    {
      "id": "d86cd015-7b7b-44dd-b608-3d1485774a22",
      "documentId": "64b548b4-8f3a-4890-bbc0-a62234321d51",
      "documentTitle": "Onboarding_Guide.md",
      "section": "First Day Arrival",
      "text": "# First Day Arrival\nNew employees should arrive at the Vijayawada office by 9:30 AM on their first day. Reception will issue a temporary visitor badge.\n# WiFi and IT Support"
    },
    {
      "id": "2f04b468-f7a1-4715-a265-7dfac6c24770",
      "documentId": "64b548b4-8f3a-4890-bbc0-a62234321d51",
      "documentTitle": "Onboarding_Guide.md",
      "section": "WiFi and IT Support",
      "text": "Connect to the company network named Company-Guest on day one. For IT issues, open a ticket through the internal IT Help Desk and include your device name and a short description.\n# First-Day Checklist\nComplete HR onboarding, activate company email, collect your employee badge, attend the office tour, and meet your manager."
    },
    {
      "id": "026010b9-8c57-4823-a172-6d1a552214db",
      "documentId": "64b548b4-8f3a-4890-bbc0-a62234321d51",
      "documentTitle": "Onboarding_Guide.md",
      "section": "Office Tour",
      "text": "# Office Tour\nThe office tour covers reception, meeting rooms, engineering workspace, pantry, and the emergency assembly point."
    },
    {
      "id": "97384072-e13d-4596-ba40-75249fb4de3a",
      "documentId": "8b8d51d8-8aaf-4a7d-acf4-5b2173a4a533",
      "documentTitle": "Team_Structure.md",
      "section": "Departments",
      "text": "# Departments\nThe company has Engineering, Design, Sales, Finance, People Operations, and Customer Success departments.\n# Engineering Team"
    },
    {
      "id": "7d64a8ef-36e0-4d01-a644-c2e12016b24e",
      "documentId": "8b8d51d8-8aaf-4a7d-acf4-5b2173a4a533",
      "documentTitle": "Team_Structure.md",
      "section": "Engineering Team",
      "text": "Engineering owns product development, reliability, internal tooling, and technical quality.\n# Engineering Manager\nThe Engineering Manager coordinates engineering priorities, team rituals, and onboarding support."
    },
    {
      "id": "c1dc1246-62d9-4260-b82f-31112ae111d8",
      "documentId": "8b8d51d8-8aaf-4a7d-acf4-5b2173a4a533",
      "documentTitle": "Team_Structure.md",
      "section": "Team Responsibilities",
      "text": "# Team Responsibilities\nProduct teams work cross-functionally with design and sales. Engineers participate in standups, reviews, planning, and incident response as relevant to their team."
    },
    {
      "id": "c3d1fada-2ec4-4f51-8dff-10f90d4576ab",
      "documentId": "5452e4e4-eafb-4b81-aefd-5fbdedbe8dcc",
      "documentTitle": "Work_From_Home_Policy.md",
      "section": "Remote Work Rules",
      "text": "# Remote Work Rules\nEmployees may work remotely on approved days according to their team arrangement. Keep your calendar and working location current.\n# Meeting Expectations"
    },
    {
      "id": "dc71d13a-6cb7-437b-96bb-6aa44c35f7c5",
      "documentId": "5452e4e4-eafb-4b81-aefd-5fbdedbe8dcc",
      "documentTitle": "Work_From_Home_Policy.md",
      "section": "Meeting Expectations",
      "text": "Join scheduled meetings on time, keep your status current, and communicate early when you cannot attend.\n# Communication Guidelines\nUse company chat for quick coordination, the issue tracker for work items, and documented channels for decisions that teammates may need later."
    }
  ],
